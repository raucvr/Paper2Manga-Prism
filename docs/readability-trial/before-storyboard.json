    {
      "n": 1,
      "kind": "scene",
      "narration": "这是论文里校准过的Qwen3-1.7B 2比特模型。",
      "dialogue": [
        {
          "speaker": "kumo",
          "text": "这个2比特模型怎么不行？它最看好“some”，老师要“a”。"
        },
        {
          "speaker": "kumo",
          "text": "旧的QAT用固定的全精度回答来训练它。"
        }
      ],
      "board": null
    },
    {
      "n": 2,
      "kind": "scene",
      "narration": "作者发现了两个阻碍性能提升的核心问题。",
      "dialogue": [
        {
          "speaker": "papi",
          "text": "这正是这篇论文要解决的问题。"
        },
        {
          "speaker": "nezu",
          "text": "小修小补而已。我赌一个浆果挞，它修不好长任务。"
        }
      ],
      "board": null
    },
    {
      "n": 3,
      "kind": "board",
      "narration": "首先是论文自己的总结。",
      "dialogue": [
        {
          "speaker": "kumo",
          "text": "我们来验证一下这些说法是否成立。"
        }
      ],
      "board": {
        "kind": "list",
        "title": "论文的主张",
        "subtitle": "论文自己的总结",
        "items": [
          "QAT旨在恢复压缩后极低位大模型的推理能力",
          "旧QAT通常只用固定的现成答案训练",
          "旧模型长任务失败，token耗尽",
          "两大缺陷：错配+双向误差",
          "OnQ：提出的极低位恢复流程",
          "OnQ在8B 2比特平均分上比BitDistiller高10.26分"
        ],
        "open": true
      }
    },
    {
      "n": 4,
      "kind": "board",
      "narration": "第一个核心缺陷：轨迹发散。回答越长，错配越严重。",
      "dialogue": [
        {
          "speaker": "papi",
          "text": "旧训练从没见过学生模型真实生成的路径。"
        }
      ],
      "board": {
        "kind": "compare",
        "title": "训练前缀错配",
        "subtitle": "固定训练忽略了学生模型实际写出的内容",
        "left": {
          "label": "旧的固定训练",
          "items": [
            "只用参考答案训练",
            "从没见过这个“some”前缀",
            "错配随长度增长"
          ]
        },
        "right": {
          "label": "学生模型的实际行为",
          "items": [
            "生成自己的前缀",
            "这个“some”前缀是真实存在的",
            "这种情况没有训练过"
          ]
        }
      }
    },
